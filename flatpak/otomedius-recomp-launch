#!/bin/sh
# Launcher: the game data lives read-only inside the Flatpak; the game wants
# to write its bookkeeping files next to it, so work on a private copy in the
# sandbox's writable data directory.
set -eu

GAME_SRC=/app/share/otomedius-recomp/game
GAME_DIR="${XDG_DATA_HOME:-$HOME/.var/app/io.github.nicobm.OtomediusRecomp/data}/otomedius"

if [ ! -d "$GAME_DIR" ]; then
    mkdir -p "$(dirname "$GAME_DIR")"
    cp -a "$GAME_SRC" "$GAME_DIR"
fi

# The game opens "oto.ini"; the arcade dump ships the same file as
# "otomedius.ini", so provide the name the game expects.
if [ ! -f "$GAME_DIR/oto.ini" ] && [ -f "$GAME_DIR/otomedius.ini" ]; then
    cp -f "$GAME_DIR/otomedius.ini" "$GAME_DIR/oto.ini"
fi

# The cabinet artwork (bezel.png) arrived with a later dump revision.  Older
# installs already have GAME_DIR, so copy the art in when it is missing; an
# existing file is left alone because the user may have replaced it.
if [ -f "$GAME_SRC/bezel.png" ] && [ ! -f "$GAME_DIR/bezel.png" ]; then
    cp -f "$GAME_SRC/bezel.png" "$GAME_DIR/bezel.png"
fi

# The intro movie is WMV3.  Its decoder lives in the runtime's codecs-extra
# extension (mounted under /usr/lib/<arch>/codecs-extra).  The runtime puts
# that directory in the loader configuration, but the base libavcodec comes
# first, so put it ahead explicitly.  Without the extension the game still
# runs; the video simply never produces frames.
CODECS="/usr/lib/x86_64-linux-gnu/codecs-extra/lib"
if [ -d "$CODECS" ]; then
    LD_LIBRARY_PATH="$CODECS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
fi

exec /app/bin/otomedius-recomp "$GAME_DIR"
